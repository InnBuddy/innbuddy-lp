  return (
    <div className="ota-mobile-bottom-nav md:hidden fixed bottom-2 left-2 right-2 z-[9999] pb-[env(safe-area-inset-bottom)]">
      <div className="w-full bg-[#E0F2FE]/95 backdrop-blur-xl border border-white/60 shadow-[0_4px_24px_rgba(14,165,233,0.15)] rounded-[2.5rem] flex justify-around items-center h-[72px] px-2">
        
        {/* 無料診断 */}
        <button 
          type="button"
          data-ota-mobile-action="diagnostic"
          onClick={(event) => {
            event.preventDefault()
            event.stopPropagation()
            // Native touch fallback handles touch devices first; avoid firing twice.
            if (event.currentTarget.dataset.otaTouchHandled === 'true') {
              delete event.currentTarget.dataset.otaTouchHandled
              return

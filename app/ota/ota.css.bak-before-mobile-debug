/* RESPONSIVE */
@media (max-width: 1024px) {
  .problem-cards-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 960px) {
  .hero-2col-wrap {
    grid-template-columns: 1fr;
    text-align: center;
    gap: 36px;
  }
  .hero-left-content {
    align-items: center;
  }
  .hero-editorial-panel-group {
    position: static;
    height: auto;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 100%;
    margin: 30px auto 0;
    gap: 16px;
  }
  .square-glass-panel {
    position: relative;
    top: auto !important;
    left: auto !important;
    right: auto !important;
    transform: none !important;
  }
  .hero-center-backdrop {
    width: 90vw;
    opacity: 0.25;
  }
  .service-grid,
  .ota-columns,
  .contact-grid-split {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .contact-split-left {
    align-items: center;
    text-align: center;
  }
  .ota-page-root .ota-footer-links-row {
    flex-direction: column !important;
    align-items: flex-start !important;
    gap: 16px !important;
  }
  .ota-page-root .ota-footer-copy {
    margin: 0 !important;
  }
}

@media (max-width: 900px) {
  .framework-flow-wrapper {
    flex-direction: column;
    gap: 24px;
  }
  .framework-cat-group {
    width: 100%;
  }
  .framework-cat-steps {
    flex-direction: column;
    gap: 10px;
  }
  .framework-step-card {
    min-height: auto;
    flex-direction: row; 
    align-items: center;
    padding: 16px 20px;
    text-align: left;
    gap: 16px;
  }
  .fstep-top {
    display: flex;
    align-items: baseline;
    gap: 12px;
    min-width: 160px;
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }
  .fstep-bottom {
    margin: 0;
  }
  .fstep-desc {
    white-space: normal; 
    max-width: 100%;
  }
}

@media (max-width: 600px) {
  .site-header {
    padding: 0 20px;
  }
  .site-header nav a:not(.header-cta) {
    display: none;
  }
  .hero {
    height: auto;
    min-height: 100vh;
    padding: 90px 20px 40px;
  }
  .section {
    padding: 70px 0;
  }
  .inbound-square-cards {
    grid-template-columns: 1fr;
  }
  .inbound-square-modal {
    padding: 30px 20px;
  }
  .square-glass-panel {
    width: 100%;
    height: auto;
    aspect-ratio: auto;
    padding: 20px;
  }
  .problem-cards-grid {
    grid-template-columns: 1fr;
  }
  .fstep-top {
    min-width: 120px;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }
  .service button {
    padding: 16px 14px;
    font-size: 14px;
  }
  .service-content {
    padding: 0 14px 18px 45px;
  }
  .ota-footer-links-group {
    flex-direction: column !important;
    align-items: flex-start !important;
    gap: 12px !important;
  }
}